services:
  - type: web
    name: owner-bot-platform
    runtime: python
    region: singapore
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: python bot.py
    healthCheckPath: /healthz
    autoDeploy: true
    envVars:
      - key: PYTHON_VERSION
        value: 3.12.7
      - key: BOT_TOKEN
        sync: false
      - key: OWNER_IDS
        sync: false
      - key: ENCRYPTION_KEY
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: owner-bot-db
          property: connectionString
      - key: LOG_LEVEL
        value: INFO
    disk:
      name: owner-bot-data
      mountPath: /var/data
      sizeGB: 1

databases:
  - name: owner-bot-db
    region: singapore
    plan: free
    databaseName: owner_bot
    user: owner_bot
